# Offline demo mode is the default. Leave this blank for a no-key local build.
VITE_AI_API_ENDPOINT=

# Server-only variables for api/ai-assistant.js. Never rename the key to a
# VITE_* variable because Vite exposes those values to the browser bundle.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
