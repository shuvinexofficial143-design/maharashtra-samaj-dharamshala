<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">#661B1C</item>
        <item name="colorPrimaryDark">#461011</item>
        <item name="colorAccent">#E9AD3F</item>
        <item name="android:colorAccent">#E9AD3F</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:statusBarColor">#FFFDF8</item>
        <item name="android:navigationBarColor">#FFFDF8</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowBackground">#FFFDF8</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>


    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#5F1717</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@drawable/splash</item>
    </style>
</resources>
